generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String        @id @default(uuid())
  email            String        @unique
  createdAt        DateTime      @default(now())
  avatar           String?
  cooperativeId    String?
  emailVerified    Boolean       @default(false)
  firstName        String
  isActive         Boolean       @default(true)
  lastName         String
  password         String
  phone            String?
  role             UserRole
  updatedAt        DateTime      @updatedAt
  activities       ActivityLog[]
  approvals        Approval[]
  receivedMessages Message[]     @relation("MessageReceiver")
  sentMessages     Message[]     @relation("MessageSender")
  otps             OTP[]
  orders           Order[]
  requests         Request[]
  reviews          Review[]
  transactions     Transaction[]
  wishlistItems    Wishlist[]
  returnRequests   ReturnRequest[]
  cooperative      Cooperative?  @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  chatConversations ChatConversation[] @relation("BuyerConversation")
  chatMessages      ChatMessage[]      @relation("ChatMessageSender")
  notifications     Notification[]
  userLoyalties     UserLoyalty[]
  productViews      ProductView[]

  @@index([email])
  @@index([cooperativeId])
}

model OTP {
  id        String   @id @default(uuid())
  userId    String
  code      String
  type      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([code])
}

model Cooperative {
  id                 String            @id @default(uuid())
  name               String
  registrationNumber String            @unique
  email              String            @unique
  phone              String
  address            String
  district           String
  sector             String
  cell               String
  village            String
  type               String
  description        String?
  logo               String?
  certificateUrl     String?
  constitutionUrl    String?
  status             CooperativeStatus @default(PENDING)
  foundedDate        DateTime?
  totalMembers       Int               @default(0)
  verifiedBy         String?
  verifiedAt         DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  activities         ActivityLog[]
  announcements      Announcement[]
  products           Product[]
  reports            Report[]
  requests           Request[]
  transactions       Transaction[]
  users              User[]
  chatConversations  ChatConversation[]
  campaigns          Campaign[]

  @@index([registrationNumber])
  @@index([status])
}

model Product {
  id             String      @id @default(uuid())
  cooperativeId  String
  name           String
  description    String
  category       String
  price          Float
  unit           String
  availableStock Float
  images         String[]
  quality        String?
  location       String?
  shippingCost   Float       @default(0)
  isActive       Boolean     @default(true)
  averageRating  Float?      @default(0)
  reviewCount    Int         @default(0)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  orderItems     OrderItem[]
  reviews        Review[]
  wishlistItems  Wishlist[]
  returnRequests ReturnRequest[]
  campaignProducts CampaignProduct[]
  productViews   ProductView[]
  cooperative    Cooperative @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)

  @@index([cooperativeId])
  @@index([category])
  @@index([averageRating])
}

model Order {
  id              String          @id @default(uuid())
  createdAt       DateTime        @default(now())
  buyerId         String
  deliveryAddress String
  notes           String?
  orderNumber     String          @unique
  paymentMethod   String
  paymentStatus   String          @default("PENDING")
  status          OrderStatus     @default(PENDING)
  totalAmount     Float
  transactionRef String?         @unique
  shippingMethod  String?
  shippingCost    Float?          @default(0)
  updatedAt       DateTime        @updatedAt
  messages        Message[]
  buyer           User            @relation(fields: [buyerId], references: [id])
  items           OrderItem[]
  returnRequests  ReturnRequest[]
  chatConversations ChatConversation[]

  @@index([buyerId])
  @@index([orderNumber])
  @@index([status])
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  productId String
  quantity  Float
  price     Float
  subtotal  Float
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model Transaction {
  id             String            @id @default(uuid())
  cooperativeId  String
  userId         String?
  type           TransactionType
  amount         Float
  description    String
  category       String?
  reference      String?
  blockchainHash String?
  createdAt      DateTime          @default(now())
  status         TransactionStatus @default(PENDING)
  approvals      Approval[]
  cooperative    Cooperative       @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  user           User?             @relation(fields: [userId], references: [id])

  @@index([cooperativeId])
  @@index([userId])
  @@index([type])
}

model MemberFinancial {
  id            String   @id @default(uuid())
  memberId      String   @unique
  cooperativeId String
  shares        Float    @default(0)
  savings       Float    @default(0)
  dividends     Float    @default(0)
  loans         Float    @default(0)
  contributions Float    @default(0)
  updatedAt     DateTime @updatedAt

  @@index([memberId])
  @@index([cooperativeId])
}

model Request {
  id              String        @id @default(uuid())
  cooperativeId   String
  requesterId     String
  type            String
  amount          Float?
  description     String
  status          RequestStatus @default(PENDING)
  approvedBy      String[]
  rejectedBy      String?
  rejectionReason String?
  processedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  cooperative     Cooperative   @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  requester       User          @relation(fields: [requesterId], references: [id])

  @@index([cooperativeId])
  @@index([requesterId])
  @@index([status])
}

model Approval {
  id            String        @id @default(uuid())
  transactionId String
  approverId    String
  status        RequestStatus @default(PENDING)
  comment       String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  approver      User          @relation(fields: [approverId], references: [id])
  transaction   Transaction   @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@unique([transactionId, approverId])
  @@index([transactionId])
  @@index([approverId])
}

model Announcement {
  id            String           @id @default(uuid())
  cooperativeId String?
  title         String
  content       String
  type          String
  isPublic      Boolean          @default(false)
  attachments   String[]
  postedBy      String
  expiresAt     DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  cooperative   Cooperative?     @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  applications  JobApplication[]

  @@index([cooperativeId])
  @@index([type])
}

model JobApplication {
  id             String       @id @default(uuid())
  announcementId String
  applicantName  String
  applicantEmail String
  applicantPhone String
  resume         String?
  coverLetter    String?
  status         String       @default("PENDING")
  createdAt      DateTime     @default(now())
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@index([announcementId])
}

model Report {
  id            String      @id @default(uuid())
  cooperativeId String
  title         String
  type          String
  period        String
  content       Json
  fileUrl       String?
  generatedBy   String
  createdAt     DateTime    @default(now())
  cooperative   Cooperative @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)

  @@index([cooperativeId])
  @@index([type])
  @@index([period])
}

model Review {
  id            String   @id @default(uuid())
  buyerId       String
  productId     String
  cooperativeId String
  orderId       String?  @unique
  rating        Int
  comment       String?
  verified      Boolean  @default(false)
  helpfulCount  Int      @default(0)
  images        String[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  buyer         User     @relation(fields: [buyerId], references: [id])
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([cooperativeId])
  @@index([buyerId])
  @@index([productId])
  @@index([rating])
  @@index([createdAt])
}

model ActivityLog {
  id            String       @id @default(uuid())
  userId        String
  cooperativeId String?
  action        String
  entity        String
  entityId      String?
  details       Json?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime     @default(now())
  cooperative   Cooperative? @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([cooperativeId])
  @@index([action])
  @@index([createdAt])
}

model Invitation {
  id            String    @id @default(uuid())
  email         String
  cooperativeId String
  role          UserRole
  token         String    @unique
  expiresAt     DateTime
  usedAt        DateTime?
  invitedBy     String
  createdAt     DateTime  @default(now())

  @@index([email])
  @@index([token])
  @@index([cooperativeId])
}

model Contact {
  id          String        @id @default(uuid())
  name        String
  email       String
  subject     String
  message     String
  status      ContactStatus @default(PENDING)
  response    String?
  respondedAt DateTime?
  respondedBy String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([email])
  @@index([status])
}

model Message {
  id         String        @id @default(uuid())
  orderId    String
  senderId   String
  receiverId String
  subject    String
  content    String
  status     MessageStatus @default(SENT)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  order      Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  receiver   User          @relation("MessageReceiver", fields: [receiverId], references: [id])
  sender     User          @relation("MessageSender", fields: [senderId], references: [id])

  @@index([orderId])
  @@index([senderId])
  @@index([receiverId])
  @@index([status])
}

model ChatConversation {
  id             String             @id @default(uuid())
  orderId        String?
  cooperativeId  String?
  buyerId        String?
  subject        String?
  status         ConversationStatus @default(ACTIVE)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  lastMessageAt  DateTime?
  messages       ChatMessage[]
  cooperative    Cooperative?       @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  buyer          User?              @relation("BuyerConversation", fields: [buyerId], references: [id])
  order          Order?             @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([cooperativeId])
  @@index([buyerId])
  @@index([status])
}

model ChatMessage {
  id             String             @id @default(uuid())
  conversationId String
  senderId       String
  content        String
  attachments    String[]           @default([])
  readAt         DateTime?
  createdAt      DateTime           @default(now())
  conversation   ChatConversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User               @relation("ChatMessageSender", fields: [senderId], references: [id])

  @@index([conversationId])
  @@index([senderId])
}

model Campaign {
  id             String            @id @default(uuid())
  name           String
  description    String?
  type           CampaignType      @default(PROMO)
  status         CampaignStatus    @default(LIVE)
  bannerImage    String?
  startDate      DateTime?
  endDate        DateTime?
  discountValue  Float?
  discountType   DiscountType      @default(FIXED)
  benefits       String?
  featured       Boolean           @default(false)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  cooperativeId  String?
  cooperative    Cooperative?      @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  products       CampaignProduct[]

  @@index([status])
  @@index([type])
  @@index([startDate])
  @@index([endDate])
  @@index([cooperativeId])
}

model CampaignProduct {
  id         String     @id @default(uuid())
  campaignId String
  productId  String
  priority   Int        @default(0)
  campaign   Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([campaignId, productId])
  @@index([campaignId])
  @@index([productId])
}

model LoyaltyTier {
  id            String      @id @default(uuid())
  name          String
  badge         String?
  minSpend      Float
  benefits      String?
  color         String?
  priority      Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  users         UserLoyalty[]

  @@index([minSpend])
  @@index([priority])
}

model UserLoyalty {
  id        String      @id @default(uuid())
  userId    String
  tierId    String
  points    Float       @default(0)
  lifetime  Float       @default(0)
  updatedAt DateTime    @updatedAt
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier      LoyaltyTier @relation(fields: [tierId], references: [id], onDelete: Cascade)

  @@unique([userId, tierId])
  @@index([userId])
  @@index([tierId])
}

model ProductView {
  id            String      @id @default(uuid())
  userId        String?
  productId     String
  cooperativeId String?
  viewedAt      DateTime    @default(now())
  user          User?       @relation(fields: [userId], references: [id])
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([productId])
  @@index([viewedAt])
}

model Language {
  id         String   @id @default(uuid())
  code       String   @unique
  name       String
  direction  String   @default("ltr")
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Currency {
  id         String   @id @default(uuid())
  code       String   @unique
  symbol     String
  name       String
  rate       Float    @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model AnalyticsSnapshot {
  id               String     @id @default(uuid())
  metric           String
  value            Float
  metadata         Json?
  capturedAt       DateTime   @default(now())
  createdAt        DateTime   @default(now())

  @@index([metric])
  @@index([capturedAt])
}

model Notification {
  id           String       @id @default(uuid())
  recipientId  String
  type         NotificationType
  title        String
  description  String?
  payload      Json?
  read         Boolean      @default(false)
  createdAt    DateTime     @default(now())
  recipient    User         @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId])
  @@index([type])
  @@index([read])
}

enum UserRole {
  SUPER_ADMIN
  RCA_REGULATOR
  COOP_ADMIN
  SECRETARY
  ACCOUNTANT
  MEMBER
  BUYER
}

enum CooperativeStatus {
  PENDING
  APPROVED
  SUSPENDED
  REJECTED
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TransactionType {
  INCOME
  EXPENSE
  CONTRIBUTION
  DIVIDEND
  LOAN
  LOAN_REPAYMENT
  WITHDRAWAL
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum TransactionStatus {
  PENDING
  APPROVED
  REJECTED
  PROCESSING
}

enum ContactStatus {
  PENDING
  RESPONDED
  CLOSED
}

enum MessageStatus {
  SENT
  READ
  ARCHIVED
}

enum ConversationStatus {
  ACTIVE
  RESOLVED
  ARCHIVED
}

enum CampaignType {
  PROMO
  BUNDLE
  FLASH
}

enum CampaignStatus {
  DRAFT
  LIVE
  ENDED
}

enum DiscountType {
  FIXED
  PERCENTAGE
}

enum NotificationType {
  CHAT_MESSAGE
  PROMOTION
  SYSTEM
}

model Wishlist {
  id        String   @id @default(uuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

model ReturnRequest {
  id           String       @id @default(uuid())
  orderId      String
  buyerId      String
  productId    String
  orderItemId  String?
  reason       String
  description  String?
  status       ReturnStatus @default(PENDING)
  refundAmount Float?
  refundMethod String?
  refundRef    String?
  images       String[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  processedAt  DateTime?
  processedBy  String?
  rejectionReason String?
  order        Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  buyer        User         @relation(fields: [buyerId], references: [id])
  product      Product      @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([buyerId])
  @@index([productId])
  @@index([status])
  @@index([createdAt])
}

enum ReturnStatus {
  PENDING
  APPROVED
  REJECTED
  REFUNDED
  CANCELLED
  PROCESSING
}
